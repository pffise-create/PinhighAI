{
  "expo": {
    "name": "PinHigh AI",
    "slug": "PinHighAI",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "scheme": "golfcoach",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pinhighai.golfcoach",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "PinHigh AI needs camera access to record your golf swing for analysis.",
        "NSPhotoLibraryUsageDescription": "PinHigh AI needs photo library access to select swing videos for analysis.",
        "NSMicrophoneUsageDescription": "PinHigh AI may capture audio when recording swing videos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.pinhighai.golfcoach"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      "expo-secure-store",
      "expo-web-browser",
      "expo-dev-client",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "2ec92eee-8ddd-4e73-8831-23e40a8e1e65"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2ec92eee-8ddd-4e73-8831-23e40a8e1e65"
    }
  }
}
